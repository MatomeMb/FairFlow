# =============================================================================
# Fairflow — Root Environment Variable Reference
# =============================================================================
# Copy values into the package-specific env files (never commit real secrets):
#   packages/shadow-index/.env
#   packages/auth-portal/.env
#
# Full templates:
#   packages/shadow-index/.env.example
#   packages/auth-portal/.env.example
# =============================================================================

# --- Core API (packages/shadow-index) ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_API_BASE_URL=http://localhost:3000
AUTH_PORTAL_BASE_URL=http://localhost:5178

# Auth & secrets (generate strong random values for any shared environment)
JWT_SECRET=generate-a-random-64-char-hex-string
ADMIN_SECRET_KEY=your-admin-secret
SHADOW_INDEX_API_KEY=your-dev-api-key-here

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Payments — Paystack (primary)
PAYSTACK_SECRET_KEY=sk_test_YOUR_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY_HERE
PAYSTACK_CALLBACK_URL=http://localhost:5178/order/confirmation

# Payments — Stripe (optional / legacy)
# STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
# STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# Google OAuth (merchant auth)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
# GOOGLE_OAUTH_MODE=dev

# Storage
STORAGE_MODE=local
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=matter-artifacts
# CLOUDFLARE_R2_PUBLIC_URL=

# KYC — Sumsub
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_FLOW_NAME=merchant-kyc

# Email — Resend (optional)
# RESEND_API_KEY=
# MERCHANT_EMAIL=

# Cryptographic signing (Ed25519) — optional for local
# SIGNING_PRIVATE_KEY=
# SIGNING_PUBLIC_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
BATCH_MAX_SIZE=100

# --- Frontend (packages/auth-portal) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_API_BASE_URL=http://localhost:3000
VITE_API_KEY=your-dev-api-key-here
# VITE_ADMIN_EMAILS=ceo@example.com,cto@example.com
