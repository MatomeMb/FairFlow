{
  "name": "@thingsthatmatter/shadow-index",
  "version": "0.6.0",
  "description": "Shadow Index API - Fast hash-to-artifact resolution service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "build": "tsc",
    "start": "node run-with-env.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "verify-r2": "node scripts/verify-r2.mjs",
    "smoke:prod": "node scripts/smoke-vercel.mjs",
    "pre-aggregate": "npm run build && node scripts/run-pre-aggregation.mjs",
    "load-test": "node scripts/sustained-load-test.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "api",
    "vercel",
    "commerce",
    "shadow-index"
  ],
  "author": "Fairflow Contributors",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@hono/node-server": "^1.19.9",
    "@paystack/paystack-sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.99.1",
    "hono": "^4.0.0",
    "resend": "^6.9.3",
    "zod": "^3.22.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.54.0",
    "husky": "^9.0.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
