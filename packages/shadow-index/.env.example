# ──────────────────────────────────────────────────────
# Shadow Index API — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ──────────────────────────────────────────────────────

# Server
PORT=3000
LOG_LEVEL=info

# Paystack (test keys — use sk_test_ for dev)
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_YOUR_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY_HERE
PAYSTACK_CALLBACK_URL=http://localhost:5178/order/confirmation
# Set to 0 only if you charge real USD via Paystack (otherwise legacy portal products stored as USD are charged as ZAR)
# PAYSTACK_LEGACY_USD_AS_ZAR=0

# API Authentication
SHADOW_INDEX_API_KEY=your-dev-api-key-here
# SHADOW_INDEX_API_KEYS=key1,key2  # Optional: multiple keys
# SHADOW_INDEX_REVOKED_KEYS=old-key  # Optional: revoked keys

# Admin
ADMIN_SECRET_KEY=your-admin-secret

# Supabase (DB + admin proxy CEO/CTO validation on /v1/admin-proxy)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Supabase service key (from Supabase dashboard → Settings → API → service_role key)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# JWT (merchant sessions, Google OAuth tokens)
JWT_SECRET=generate-a-random-64-char-hex-string

# Google OAuth (Merchant Auth)
# Set GOOGLE_OAUTH_MODE=dev to bypass real Google OAuth in local development
# GOOGLE_OAUTH_MODE=dev
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
AUTH_PORTAL_BASE_URL=http://localhost:5178
# Comma-separated portal origins allowed in Google OAuth state return_to (default: AUTH origin + www/non-www pair).
# OAUTH_ALLOWED_RETURN_ORIGINS=https://www.fairflow.co.za,https://fairflow.co.za

# If merchant_accounts.user_id is NOT NULL, set to a dedicated auth.users UUID (service-created) or run migration 008.
# MERCHANT_OAUTH_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# Optional: OAuth completion via Set-Cookie (no ?token= in redirect). Use e.g. `.fairflow.co.za`.
# Must match VITE_MERCHANT_OAUTH_COOKIE_DOMAIN on the auth-portal Vercel project.
# MERCHANT_OAUTH_COOKIE_DOMAIN=.fairflow.co.za

# Storage: "local" (default) or "r2"
STORAGE_MODE=local
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret
# R2_BUCKET_NAME=your-bucket

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Batch Compilation
BATCH_MAX_SIZE=100

# Production URL (used for thing_url in compiled artifacts)
# Production:
# PUBLIC_API_BASE_URL=https://api.fairflow.co.za
# AUTH_PORTAL_BASE_URL=https://portal.fairflow.co.za
# Custom domain (when configured):
# PUBLIC_API_BASE_URL=https://api.fairflow.co.za

# Optional: Resend email
# RESEND_API_KEY=re_your_key
# MERCHANT_EMAIL=your@email.com
# Optional: absolute URL to ff logo image for HTML emails (PNG recommended for picky clients; else uses AUTH_PORTAL_BASE_URL/fairflow-logo.svg)
# FAIRFLOW_EMAIL_LOGO_URL=https://portal.example.com/fairflow-logo.png

# Optional: KYC encryption at rest
# KYC_ENCRYPTION_KEY=64-char-hex-string

# Sumsub KYC (replaces Smile ID)
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_FLOW_NAME=merchant-kyc
# Public base URL for webhook registration in Sumsub dashboard (use ngrok in dev)
# SUMSUB_CALLBACK_URL=https://abc.ngrok.io/v1/merchant/kyc/callback
# Local curl tests only — never enable in production
# SUMSUB_SKIP_SIGNATURE_VERIFY=true
